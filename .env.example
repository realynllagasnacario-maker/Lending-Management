# Copy to .env and keep private. Do not commit .env.

# local while developing. production on the public server.
APP_ENV=local

# Public address of this app, no trailing slash.
# Example: https://yourdomain.com
APP_URL=http://localhost/lending_system

# Set to 1 only after the domain has HTTPS.
APP_FORCE_HTTPS=0

# MySQL (optional — defaults: root / empty / lending_management)
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=change_me

# Set to 1 to run loan status sync on every page request.
# Leave at 0 in production and run lending_system/tools/sync_loan_status_cli.php daily.
LOAN_STATUS_SYNC_ON_REQUEST=0

# PayMongo Dynamic QR Ph — set PAYMONGO_MODE=test (default) or live for real QR Ph collections.
PAYMONGO_SECRET_KEY=your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key
PAYMONGO_MODE=test
# Webhook signing secret from PayMongo Dashboard (must match test or live mode above).
PAYMONGO_WEBHOOK_SECRET=your_paymongo_webhook_secret
# Optional live smoke-test cap (PHP pesos). Example: 1 limits live QR Ph to ₱1.00 while set.
# PAYMONGO_LIVE_MAX_AMOUNT=1

# Automated eligibility estimate (DTI — not automatic loan approval)
LENDING_MAX_DTI=40
LENDING_MIN_LOAN=3000
LENDING_MAX_LOAN=500000
LENDING_MIN_EMPLOYMENT_MONTHS=3

# Public company details (invoices, receipts, contact page, emails)
COMPANY_NAME=Your Company Name
COMPANY_TAGLINE=Your Company Tagline
COMPANY_ADDRESS=Your Company Address
COMPANY_PHONE=Your Company Phone
COMPANY_EMAIL=company@example.com
# Optional name shown as e-signature on payment receipts (defaults to first active admin user).
# INVOICE_AUTHORIZED_SIGNATORY=Full Name of Administrator

# Gmail SMTP configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=change_me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=RJ and RR Finance Services
SMTP_TIMEOUT=20
